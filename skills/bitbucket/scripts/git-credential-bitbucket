#!/bin/sh
# git-credential-bitbucket — git credential helper for bitbucket.org.
#
# Answers `get` with the login the gateway gave this session
# (BITBUCKET_LOGIN_FILE). Says nothing when there is none, so git moves on to
# the next helper. Configure it once per machine:
#
#   git config --system credential.https://bitbucket.org.helper /path/to/git-credential-bitbucket
set -eu

[ "${1:-}" = get ] || exit 0
[ -n "${BITBUCKET_LOGIN_FILE:-}" ] && [ -r "$BITBUCKET_LOGIN_FILE" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ "$key" = host ] && host="$value"
done
[ "$host" = bitbucket.org ] || exit 0

token="$(sed -n 's/^token=//p' "$BITBUCKET_LOGIN_FILE")"
[ -n "$token" ] || exit 0
printf 'username=x-bitbucket-api-token-auth\npassword=%s\n' "$token"
